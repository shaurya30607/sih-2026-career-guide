# SkillSaathi Backend Environment Variables
DATABASE_URL=sqlite:///./skillsaathi.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Optional Grounded AI LLM Provider Configuration
# When set, SkillSaathi activates server-side grounded AI counselling.
# When unset, SkillSaathi runs in deterministic evidence-grounded mode.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=5.0
